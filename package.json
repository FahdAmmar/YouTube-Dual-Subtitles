{
  "name": "youtube-dual-subtitles",
  "private": true,
  "version": "1.0.0",
  "description": "Watch YouTube, Vimeo or local videos with two synchronized subtitle tracks, a lyrics-style reading mode and a vocabulary trainer — fully client-side.",
  "type": "module",
  "engines": {
    "node": "^22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "budget": "node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:strict": "node scripts/check-strict-lint.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/reading-mode.a11y.mjs",
    "e2e:screens": "node e2e/screens.a11y.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "keywords": [
    "youtube",
    "subtitles",
    "dual-subtitles",
    "language-learning",
    "react",
    "typescript",
    "vite",
    "pwa",
    "vocabulary",
    "spaced-repetition"
  ]
}
